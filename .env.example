# Copy this file to .env.local and fill in your own values. Never commit the real keys.
# For production, set these in the Vercel project Environment Variables instead.

# Server-only (read by api/*, never bundled to the browser):
GEMINI_API_KEY=

# Client-side Supabase Auth for the family login gate (publishable anon key only —
# safe to expose PROVIDED Row Level Security is enforced in Supabase):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
